{
	"name": "jw-bible-reading-plan",
	"version": "0.2.0",
	"description": "Obsidian plugin: Bible reading schedule with equal daily portions",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild test/planner.test.ts --bundle --platform=node --format=cjs | node"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "20.17.10",
		"esbuild": "0.24.2",
		"obsidian": "1.5.7",
		"tslib": "2.4.0",
		"typescript": "5.4.5"
	}
}
